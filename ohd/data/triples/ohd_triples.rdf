  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinically abnormal</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000070">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000067"/>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Albert Goldfain</obo:IAO_0000117>
