      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
      <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/OHD_0000114"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a missing tooth finding in which tooth 14 is found to be missing</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <rdfs:label xml:lang="en">missing tooth 14 finding</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000029">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FMA_12516"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
