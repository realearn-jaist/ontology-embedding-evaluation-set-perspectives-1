  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amalgam filling restoration</obo:IAO_0000118>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amalgam intracoronal restoration procedure</obo:IAO_0000118>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amalgam filling restoration procedure</rdfs:label>
</owl:Class>

