  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process during which the surface of the tooth is cleaned.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-08T16:56:25Z</term:created>
