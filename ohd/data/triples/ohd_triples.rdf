  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pontic used as an interim restoration  for a duration of less than six months when a final impression is not made to allow adequate time for healing or completion of definitive treatment planning. This is not a temporary pontic for routine prosthetic fixed partial denture restoration. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interim pontic</obo:cdt_label>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D6254</x_1.1:identifier>
