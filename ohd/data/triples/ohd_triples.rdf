        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_12516"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth that has been surgically extracted from a patient's mouth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/29/2016:
This class represents those teeth which are extracted from a patient. After all, an extracted tooth is still a tooth. It just isn't part of the patient anymore.

This class provides us with a convient way to represent those teeth that have been extracted.</obo:IAO_0000116>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:15:20Z</oboI:creation_date>
  <rdfs:label xml:lang="en">extracted tooth</rdfs:label>
</owl:Class>

