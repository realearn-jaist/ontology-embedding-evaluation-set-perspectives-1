  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:39:09Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant abutment attachement procedure</rdfs:label>
</owl:Class>

