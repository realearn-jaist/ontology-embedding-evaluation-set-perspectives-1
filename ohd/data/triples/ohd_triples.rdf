      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type: class
is-a: Lower primary molar tooth
subclasses: Right lower second primary molar tooth, Left lower second primary molar tooth</obo:IAO_0000116>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lower second primary molar tooth</rdfs:label>
</owl:Class>

