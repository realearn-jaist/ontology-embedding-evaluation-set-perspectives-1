  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanically and/or chemically prepared enamel surface sealed to prevent decay. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sealant - per tooth</obo:cdt_label>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D1351</x_1.1:identifier>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">billing code D1351: sealant - per tooth</rdfs:label>
</owl:Class>

