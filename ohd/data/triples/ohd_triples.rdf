  <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/ecto_import.owl"/>
  <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/omo_import.owl"/>
  <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/ro_import.owl"/>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/OMO_0002000">
  <obo:IAO_0000233 rdf:resource="https://github.com/ontodev/robot/issues/963"/>
  <x_1.1:contributor rdf:resource="https://orcid.org/0000-0002-7356-1779"/>
  <x_1.1:contributor rdf:resource="https://orcid.org/0000-0002-8688-6599"/>
  <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/omo_import.owl"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'part disjoint with' 'defined by construct' """
    PREFIX owl: &lt;http://www.w3.org/2002/07/owl#&gt;
    PREFIX : &lt;http://example.org/
    CONSTRUCT {
      [
        a owl:Restriction ;
        owl:onProperty :part_of ;
        owl:someValuesFrom ?a ;
        owl:disjointWith [
          a owl:Restriction ;
          owl:onProperty :part_of ;
          owl:someValuesFrom ?b
        ]
      ]
    }
    WHERE {
      ?a :part_disjoint_with ?b .
    }</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an annotation property to a SPARQL CONSTRUCT query which is meant to provide semantics for a shortcut relation.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">defined by construct</rdfs:label>
</owl:AnnotationProperty>

