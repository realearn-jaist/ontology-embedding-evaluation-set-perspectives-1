  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9637"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;br&gt;&lt;b&gt;type&lt;/b&gt;: class&lt;br&gt;&lt;b&gt;is-a&lt;/b&gt;: Portion of tissue&lt;br&gt;&lt;b&gt;subclasses&lt;/b&gt;: Striated muscle tissue, Smooth muscle tissue&lt;br&gt;&lt;b&gt;preferred name&lt;/b&gt;: KB_INSTANCE_08346&lt;br&gt;&lt;b&gt;synonym&lt;/b&gt;: ONARD_Instance_610003&lt;br&gt;&lt;b&gt;non-English equivalent&lt;/b&gt;: ONARD_Instance_580867, ONARD_Instance_580209, ONARD_Instance_610004&lt;br&gt;&lt;b&gt;constitutional part&lt;/b&gt;: Vasculature of portion of muscle tissue</obo:IAO_0000116>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of tissue which has as its parts an aggregate of muscle cells surrounded by a reticulum of collagen fibers or fine connective tissue [endomysium].  Examples: Smooth muscle tissue, Cardiac muscle tissue.</rdfs:comment>
