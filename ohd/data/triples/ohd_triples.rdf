<owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_54806">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_86103"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;br&gt;&lt;b&gt;type&lt;/b&gt;: class&lt;br&gt;&lt;b&gt;is-a&lt;/b&gt;: Region of organ component&lt;br&gt;&lt;b&gt;subclasses&lt;/b&gt;: Hyoglossal membrane, Papilla of tongue&lt;br&gt;&lt;b&gt;:slot-templates&lt;/b&gt;: arterial supply &lt;i&gt;value-type&lt;/i&gt;: Class, arterial supply &lt;i&gt;value-type&lt;/i&gt;: Portion of tissue&lt;br&gt;&lt;b&gt;preferred name&lt;/b&gt;: KB_INSTANCE_69649&lt;br&gt;&lt;b&gt;synonym&lt;/b&gt;: KB_AUTO-INSERT2_4953&lt;br&gt;&lt;b&gt;non-English equivalent&lt;/b&gt;: ONARD_Instance_580120, ONARD_Instance_580634&lt;br&gt;&lt;b&gt;regional part of&lt;/b&gt;: Tongue</obo:IAO_0000116>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Region of tongue</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_85355">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_82485"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;br&gt;&lt;b&gt;type&lt;/b&gt;: class&lt;br&gt;&lt;b&gt;is-a&lt;/b&gt;: Organ component layer&lt;br&gt;&lt;b&gt;subclasses&lt;/b&gt;: Mucosa of pharyngotympanic tube, Mucosa of biliary tree, Mucosa of small intestine, Mucosa of large intestine, Mucosa of tongue, Mucosa of uterine tube, Mucosa of appendix, Mucosa of lacrimal duct, Mucosa of gallbladder, Mucosa of tracheobronchial tree, Mucosa of esophagus, Mucosa of stomach, Mucosa of vagina, Mucosa of urethra, Mucosa of anal canal, Mucosa of urinary bladder, Mucosa of ureter&lt;br&gt;&lt;b&gt;:documentation&lt;/b&gt;: Gray's 99:1747 - In the alimentary tract, subdivided into three strata, the lining epithelium, the lamina propria, and the muscularis mucosae (thin layer of smooth muscle).&lt;br&gt;&lt;b&gt;preferred name&lt;/b&gt;: ONARD_Instance_1560032&lt;br&gt;&lt;b&gt;non-English equivalent&lt;/b&gt;: ONARD_Instance_1560030&lt;br&gt;&lt;b&gt;synonym&lt;/b&gt;: ONARD_Instance_1560031, KB_AUTO-INSERT2_2251, fma_p2_Instance_50006</obo:IAO_0000116>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organ component layer lining the internal side of an organ.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mucosa</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_62130">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_284658"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;br&gt;&lt;b&gt;type&lt;/b&gt;: class&lt;br&gt;&lt;b&gt;is-a&lt;/b&gt;: Epithelium of tongue&lt;br&gt;&lt;b&gt;constitutional part of&lt;/b&gt;: Mucosa of ventrum of tongue&lt;br&gt;&lt;b&gt;preferred name&lt;/b&gt;: fm-live_15067&lt;br&gt;&lt;b&gt;:documentation&lt;/b&gt;: Bloom &amp;#x0026; Fawcett 94:559 - Characteristic of the under side of tongue.</obo:IAO_0000116>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-keratinized epithelium of tongue</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_63584">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_62517"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;br&gt;&lt;b&gt;type&lt;/b&gt;: class&lt;br&gt;&lt;b&gt;is-a&lt;/b&gt;: Lamina propria&lt;br&gt;&lt;b&gt;preferred name&lt;/b&gt;: FM_live_02406&lt;br&gt;&lt;b&gt;:documentation&lt;/b&gt;: Gray's 99:1724 - Consists of dense fibrous connective tissue with numerous elastic fibers.&lt;br&gt;&lt;b&gt;constitutional part of&lt;/b&gt;: Mucosa of tongue</obo:IAO_0000116>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lamina propria of tongue</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_74865">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_284658"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_45568"/>
