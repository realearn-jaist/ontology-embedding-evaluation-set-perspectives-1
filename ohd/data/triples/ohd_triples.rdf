<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000351">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000300"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental implant retainer attachement procedure for fixed partial denture in which the retainer being attached to the implant body is to be used as a retainer for a porcelain fused to metal fixed partial denture.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:42:02Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant retainer attachement procedure for porcelain fused to metal fixed partial denture</rdfs:label>
</owl:Class>

