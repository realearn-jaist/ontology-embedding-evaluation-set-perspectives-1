  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surgical dental procedure that removes a tooth from the oral cavity.
</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 1/14/2014: 
I think the instrumentation (" ...  by means of elevators and/or forceps")  is not relevant to this definition.  I have extracted certain teeth with two fingers.</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mosby. Mosby's Dental Dictionary, 2nd Edition. Mosby, 102007. p. 238
</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooth extraction procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000233">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FMA_12516"/>
