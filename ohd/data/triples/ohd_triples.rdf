  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-21T19:46:34Z</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0040042"/>
  <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#created_by"/>
  <owl:annotatedTarget rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0040042"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R is homemorphic for C iff (1) there exists some x,y such that x R y, and x and y instantiate C and (2) for all x, if x is an instance of C, and there exists some y some such that x R y, then it follows that y is an instance of C.</owl:annotatedTarget>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0040042"/>
