  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth cleaning process during which an object is used to clean the tooth (or teeth) by applying a powder, paste, or liquid (i.e., dentifrice).</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-08T16:59:29Z</term:created>
  <rdfs:label xml:lang="en">toothbrushing</rdfs:label>
</owl:Class>

