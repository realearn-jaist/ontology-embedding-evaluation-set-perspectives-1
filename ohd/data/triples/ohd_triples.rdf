  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental finding that a tooth has been restored.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:37:27Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored tooth finding</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000189">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FMA_12516"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
