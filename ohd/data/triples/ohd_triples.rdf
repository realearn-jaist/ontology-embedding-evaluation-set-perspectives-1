  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">billing code D2961: labial veneer (resin laminate) - laboratory</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/CDT_0002962">
