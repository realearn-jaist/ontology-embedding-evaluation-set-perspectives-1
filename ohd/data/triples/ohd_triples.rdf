  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cartilage organ of the skeletal system. Examples: nasal cartilage, intervertebral disk.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skeletal cartilage organ</rdfs:label>
</owl:Class>

