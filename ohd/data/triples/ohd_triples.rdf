</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000019">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000057"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000052"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000010"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 xml:lang="en">A conversational, visual and tactile examination in which the clinician evaluates the status of the patient's medical, dental and oral health. </obo:IAO_0000115>
  <obo:IAO_0000116 xml:lang="en">Melissa Haendel 4/12/2012: There can be more than one dental exam that occurs during a dental visit.</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 1/1/2014: original definition was too narrow, now expanded</obo:IAO_0000116>
  <obo:IAO_0000117 xml:lang="en">Mellisa Haendel</obo:IAO_0000117>
  <obo:IAO_0000117 xml:lang="en">Person:Alan Ruttenberg</obo:IAO_0000117>
  <rdfs:label xml:lang="en">dental exam</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000020">
  <owl:equivalentClass>
