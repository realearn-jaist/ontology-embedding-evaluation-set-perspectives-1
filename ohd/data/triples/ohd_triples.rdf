  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDT_1000028"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root resection of a multi-rooted tooth while leaving the crown.  If the crown is sectioned,  see D3920. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">root amputation - per root</obo:cdt_label>
