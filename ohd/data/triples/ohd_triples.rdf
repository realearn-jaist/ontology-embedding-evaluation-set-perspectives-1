  <rdfs:label xml:lang="en">health care office staff role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000220">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000010"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000010"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental finding that one or more surfaces of a tooth have been restored.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:39:35Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored tooth surface finding</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000221">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000010"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental finding that a dental procedure has been performed on a patient's mouth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/27/2016:

This finding can indicate that a procedure was performed even when the output is not observable. For example, by looking a dental record, a provider may find that the last time a patient's teeth were cleaned was two years ago.</obo:IAO_0000116>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-27T01:45:45Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental procedure finding</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000222">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000235"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the buccal surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:41:02Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored buccal surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000235">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000208"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000222"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000225"/>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the lip-facing or cheek-facing surface of a restored tooth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 01/05/2017:
Some dental EHR systems use the letter "F" for facial surfaces rather than "L" for labial surfaces. The reason is that "L" is also used for the lingual surface.</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gopikrishnan M. Chandrasekharan 07/12/2023:
We decided that the facial surface should subsume both labial and buccal surfaces.</obo:IAO_0000116>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:42:40Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored facial surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000223">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the distal surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:41:41Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored distal surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000224">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the incisal surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:44:18Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored incisal surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000225">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000235"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the labial surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:47:52Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored labial surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000226">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the lingual surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:49:31Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored lingual surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000227">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the mesial surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:50:33Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored mesial surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000228">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000208"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth surface that forms the occlusal surface of a restored tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:51:08Z</oboI:creation_date>
  <rdfs:label xml:lang="en">restored occlusal surface</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000229">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surgical endodontic procedure involving a multi-root tooth in which the decayed root and its related coronal portion are removed to the furcation (area of bone loss).</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/29/2016:
Typically the removal of root/crown/bone is followed by the placement of an indirect restoration.</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://medical-dictionary.thefreedictionary.com/hemisection</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:30:43Z</oboI:creation_date>
  <rdfs:label xml:lang="en">hemisection procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000230">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000242"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth in which the tooth's pulp is removed and replaced by dental restoration material.</obo:IAO_0000115>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">root canal treatment procedure</obo:IAO_0000118>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:21:35Z</oboI:creation_date>
  <rdfs:label xml:lang="en">endodontic treatment procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000231">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FMA_12516"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000044"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_12516"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth in which inflamed pulp has been removed by a pulp debridement procedure.</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth that has been modified in some way as the result of some surgical dental procedure.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/29/2016:
The intent of this class is to represent teeth that have undergone some kind of surgical procedure, but which are not restored in the sense of having dental restoration material placed in them; e.g, a pulp debridement procedure.</obo:IAO_0000116>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:12:10Z</oboI:creation_date>
  <rdfs:label xml:lang="en">surgically modified tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000232">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surgical endodontic procedure in which infected pulp is removed from a tooth in order to give the remaining pulp room to swell.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/29/2016:
This procedure relieves some of the pain, allowing a root canal patient to wait longer before having the full procedure performed.</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.ehow.com/facts_7478434_pulpal-debridement.html</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:32:55Z</oboI:creation_date>
  <rdfs:label xml:lang="en">pulpal debridement procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000236">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000189"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000242"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000189"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth in which some portion of the tooth's root or pulp has been replaced by dental restoration material as a result of the tooth undergoing an endodontic restorative procedure.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:00:27Z</oboI:creation_date>
  <rdfs:label xml:lang="en">endodontically restored tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000237">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000189"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000006"/>
                <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000033"/>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000189"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A restored tooth in which some portion of enamel in the tooth's crown has been restored by dental restoration material as the result of the tooth undergoing either a crown procedure or intracoronal restoration procedure.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:55:01Z</oboI:creation_date>
  <rdfs:label xml:lang="en">coronally restored tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000238">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000237"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000033"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000237"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coronally restored tooth in which all or part of the natural dental crown is repalced by an artificial crown as a result of the tooth undergoing an crown procedure.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:56:50Z</oboI:creation_date>
  <rdfs:label xml:lang="en">extracoronally restored tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000239">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000237"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000006"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000237"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coronally restored tooth in which dental restoration material is placed into a site that is located in the crown of the tooth as the result of the tooth undergoing an intracoronal restoration procedure.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:57:51Z</oboI:creation_date>
  <rdfs:label xml:lang="en">intracoronally restored tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000240">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000237"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000027"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000237"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coronally restored tooth in which a thin layer of material (i.e., a veneer) has been placed over one or more surfaces of the tooth as a result of the tooth undergoing a veneer restoration procedure.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:59:02Z</oboI:creation_date>
  <rdfs:label xml:lang="en">veneer surface restored tooth</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000241">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000242"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endodontic restorative procedure during which a tooth's root tip is removed and a root end cavity is prepared and filled with dental restoration material.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Apicoectomy</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:20:26Z</oboI:creation_date>
  <rdfs:label xml:lang="en">apicoectomy procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000244">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surgical endodontic procure during which a root is removed from a multi-root tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:35:48Z</oboI:creation_date>
  <rdfs:label xml:lang="en">root amputation procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000245">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000002"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental procedure during which some part of the mouth is replaced by or fitted for a prothesis.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:49:03Z</oboI:creation_date>
  <rdfs:label xml:lang="en">prosthodontics procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000301">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000047"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000053"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000314"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a processed material that bears a prothetic role</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prosthesis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000246">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000245"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000281"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000245"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthodontics procedure during which a prosthesis is permanently attached to some part of the mouth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:06:45Z</oboI:creation_date>
  <rdfs:label xml:lang="en">fixed prosthodontics procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000281">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthesis that is permanently attached attached to some part of the mouth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 07/26/2017:
This class is used to group dental implants and fixed dentures under one term.</obo:IAO_0000116>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:00:32Z</oboI:creation_date>
  <rdfs:label xml:lang="en">fixed prothesis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000247">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000245"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthodontics procedure during which a removable prosthesis is either constructed or fitted to the patient's mouth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:08:52Z</oboI:creation_date>
  <rdfs:label xml:lang="en">removable prosthodontics procedure</rdfs:label>
</owl:Class>

