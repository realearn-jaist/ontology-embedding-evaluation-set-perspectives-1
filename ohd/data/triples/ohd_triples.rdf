  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The general property hierarchy is:

  "directly P" SubPropertyOf "P"
  Transitive(P)

Where we have an annotation assertion

  "directly P" "is direct form of" "P"</owl:annotatedTarget>
</owl:Axiom>

