  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
  <owl:annotatedTarget xml:lang="en">a core relation that holds between a whole and its part</owl:annotatedTarget>
</owl:Axiom>

