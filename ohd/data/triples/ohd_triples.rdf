  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute disease course</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000095">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
  <obo:IAO_0000115 xml:lang="en">A process which is a response by an organism's tissues that is generally identified by swelling or localized pain</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Albert Goldfain</obo:IAO_0000117>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://code.google.com/p/ogms/wiki/Meeting_notes_20100513</obo:IAO_0000119>
  <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creation date: 2010-07-19T11:57:44Z</obo:IAO_0000232>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inflammation process</rdfs:label>
</owl:Class>

