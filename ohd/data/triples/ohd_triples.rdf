<owl:Class rdf:about="http://purl.obolibrary.org/obo/CDT_0002799">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDT_1000023"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crown utilized as an interim restoration  of at least six months duration during restorative treatment to allow adequate time for healing or completion of other procedures.  This includes, but is not limited to changing vertical dimension, completing periodontal therapy or cracked-tooth  syndrome. This is not to be used as a temporary crown for a routine prosthetic restoration. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provisional crown</obo:cdt_label>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D2799</x_1.1:identifier>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">billing code D2799: provisional crown</rdfs:label>
</owl:Class>

