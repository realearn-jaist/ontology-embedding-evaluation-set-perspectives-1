  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental implant crown attachment procedure in which the implant crown is composed of porcelain fused to metal.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:46:37Z</oboI:creation_date>
  <rdfs:label xml:lang="en">porcelain fused to metal dental implant crown attachement procedure</rdfs:label>
</owl:Class>

