  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metal dental restoration material that is composed of a metallic alloy that contains less than 25% of gold, palladium, and/or or platinum.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predominantly base metal dental restoration material</rdfs:label>
