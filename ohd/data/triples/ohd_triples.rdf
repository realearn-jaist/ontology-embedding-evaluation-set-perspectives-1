<owl:Class rdf:about="http://purl.obolibrary.org/obo/CDT_0003920">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDT_1000009"/>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Includes separation of a multi-rooted tooth into separate sections containing the root and the overlying portion of the crown. It may also include the removal of one or more of those sections. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hemisection (including any root removal), not including root canal therapy</obo:cdt_label>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D3920</x_1.1:identifier>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">billing code D3920: hemisection (including any root removal), not including root canal therapy</rdfs:label>
</owl:Class>

