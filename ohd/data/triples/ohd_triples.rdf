  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000246"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fixed prosthodontics procedure in which a dental implant is permanently attached to the jaw.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:37:27Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000259">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000302"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthetic tooth with an anchoring structure surgically implanted beneath the mucosal or periosteal layer or in the bone.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://medical-dictionary.thefreedictionary.com/tooth+implant</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:03:18Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000249">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000247"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000254"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A removable prosthodontics procedure in which the prosthesis being constructed or fitted replaces all of the patient's teeth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:10:46Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete denture procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000254">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:35:25Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete removable denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000250">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000247"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000252"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A removable prosthodontics procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient's teeth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:12:21Z</oboI:creation_date>
  <rdfs:label xml:lang="en">removable partial denture procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000252">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000310"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A partial denture that is designed and constructed to be removed readily from the mouth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:54:24Z</oboI:creation_date>
  <rdfs:label xml:lang="en">removable partial denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000251">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000312"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fixed partial denture that is suppored and retained by underlying tissue and one or more dental implants.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:41:04Z</oboI:creation_date>
  <rdfs:label xml:lang="en">implant supported partial denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000312">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000310"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A partial denture that is permanently attached to prepared natural teeth, roots, or implants.</obo:IAO_0000115>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bridge</obo:IAO_0000118>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mosby. Mosby's Dental Dictionary, 2nd Edition. Mosby, 2008. VitalBook file. p. 175</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fixed partial denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000310">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000302"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial denture</obo:IAO_0000111>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a prosthesis that replaces one or more, but less than all, of the natural teeth and associated structures </obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial dental prothesis</obo:IAO_0000118>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mosby. Mosby's Dental Dictionary, 2nd Edition. Mosby, 2008. VitalBook file. p. 175</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000253">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthesis that replaces all the natural teeth and associated structures in either the maxilla or mandible (or both).</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:32:49Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000255">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A complete denture that is perminately attached to the mouth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:33:42Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete fixed denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000256">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A complete denture that replaces all the natural teeth and associated structures in both the maxilla and mandible.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:34:14Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete full denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000257">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A complete denture that replaces all the natural teeth and associated structures in the mandible.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:34:47Z</oboI:creation_date>
  <rdfs:label xml:lang="en">complete lower denture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000261">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000271"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechanical tooth lesion formed as a result of the tooth being fatigued, flexed, and deformed by biomechanical loading of the tooth. Tooth abfactions are primarily found in the cervical region of the tooth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tooth abfractions are usually wedge-shaped lesions with sharp-line angles, but sometimes circular invaginations on occlusal surfaces.</obo:IAO_0000116>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-06T21:30:59Z</term:created>
  <rdfs:label xml:lang="en">tooth abfraction lesion</rdfs:label>
  <core:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:109750005</core:exactMatch>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000271">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000270"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <core:broadMatch rdf:resource="http://purl.obolibrary.org/obo/GSSO_007548"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth lesion caused by brushing too hard.</obo:IAO_0000112>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth lesion caused by bruxism.</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A non-carious tooth lesion that is the result of functional or parafunctional activity of the jaws or a process of friction or an abrasive process</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-08T16:19:59Z</term:created>
  <rdfs:label xml:lang="en">mechanical tooth lesion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000262">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000290"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000407"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0002000"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 xml:lang="en">A tooth friction lesion that is caused by either the functional (e.g., mastication) or parafunctional movement of the jaws (e.g., bruxism).</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lesion are primarily found on the occlusal and incisal surfaces of the teeth, however it can be found on the proximal surfaces as well.</obo:IAO_0000116>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-06T21:31:20Z</term:created>
  <rdfs:label xml:lang="en">tooth attrition lesion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000290">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000271"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechnical tooth lesion that formed as a result of some friction process.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth friction lesion is caused by a friction process involving an external object. For example, the clasp of an ill-fitting denture, pipe stem of a tobacco pipe, friction lesion of the interproximal areas caused by vigorous use of a tooth pick etc. An abrasive material is not involved in creating the friction lesion.</obo:IAO_0000116>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-22T21:30:59Z</term:created>
  <rdfs:label xml:lang="en">tooth friction lesion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000407">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000406"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0002000"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0003304"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000045"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A masticatory muscle activity that may result in a disorder within the head and neck region.</obo:IAO_0000115>
  <obo:IAO_0000116 xml:lang="en">Involuntary holding of the teeth together and tightening of the jaw muscles or grinding of the teeth.</obo:IAO_0000116>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-06T21:27:37Z</term:created>
  <rdfs:label xml:lang="en">bruxism</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0002000">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000060"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bodily process that involves the masticatory muscles of the head and neck region.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-06T21:30:37Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">masticatory muscle activity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000263">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000270"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_9002146"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A non-carious tooth lesion that is formed as result of the tooth being exposed to acids.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-06T21:31:50Z</term:created>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dental erosion</oboI:hasRelatedSynonym>
  <rdfs:label xml:lang="en">tooth erosive lesion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000270">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000260"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth disorder that is not formed by tooth decay.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-07T14:15:31Z</term:created>
  <rdfs:label xml:lang="en">non-carious tooth lesion</rdfs:label>
</owl:Class>

