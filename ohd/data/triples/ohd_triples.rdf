  </rdfs:subClassOf>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refers also to facial veneers that extend interproximally and/or cover the incisal edge. Porcelain/ceramic  veneers  presently  include all ceramic and porcelain veneers. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
  <obo:cdt_label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labial veneer (porcelain laminate) - laboratory</obo:cdt_label>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D2962</x_1.1:identifier>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">billing code D2962: labial veneer (porcelain laminate) - laboratory</rdfs:label>
</owl:Class>

