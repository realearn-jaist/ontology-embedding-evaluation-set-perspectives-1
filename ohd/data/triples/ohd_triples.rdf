<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
  <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-06-28/ro.owl"/>
  <owl:annotatedTarget xml:lang="en">has participant</owl:annotatedTarget>
