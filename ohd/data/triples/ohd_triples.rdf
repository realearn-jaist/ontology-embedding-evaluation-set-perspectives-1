  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-09T16:29:17Z</term:created>
  <rdfs:label xml:lang="en">abrasive material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000276">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000407"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bruxism that occurs during sleep and is characterised by rhythmic (phasic) or non-rhythmic (tonic) movements of the jaw.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-06T21:39:37Z</term:created>
  <rdfs:label xml:lang="en">sleep bruxism</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000277">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000260"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth disorder that is an outcome of a ruture or break of some part of the tooth.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-08T17:13:14Z</term:created>
  <rdfs:label xml:lang="en">tooth fracture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000278">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthesis that forms the part of a prosthetic tooth  that is in direct contact with the bone and actually provides the fixation to the bone.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.ptcdental.com/dentaldictionary/i/implant-body/</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:22:55Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant body</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000279">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthesis that forms the part of a prosthetic tooth to which the restoration is attached and supports the restoration.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 07/26/2017:
Implant abutments are conical-shaped, and are screwed into a dental implant integrated into the jawbone. Today, the most common form of implant abutments are made of tooth colored material to add a more natural look to the crown that covers the abutment. This type of abutment allows the crown to blend more appropriately with adjacent teeth as is the case with the high noble metal resin crowns and porcelain-fused to noble metal crowns.

(https://www.patientconnect365.com/DentalHealthTopics/Article/Abutment__Dental_Procedure_Code_Description)</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 7/26/2017:
Most often the dental implant abutment is an intermediate component between the implant body and the restoration.</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.ptcdental.com/dentaldictionary/a/abutment/</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:19:43Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant abutment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000280">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prosthesis that forms the part of a prosthetic tooth which provides the prosthetic tooth with the functionallity and appearance of a natural tooth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:27:20Z</oboI:creation_date>
  <rdfs:label xml:lang="en">dental implant crown</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000283">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental implant body fabricated to fit the supporting areas of mandible or maxilla with permucosal extensions for support and attachment of abutments.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dentalimplants.uchc.edu/about/types.html</obo:IAO_0000119>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://implantdirect.co/ai/implantcatalogpdf/glossary.pdf</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:25:20Z</oboI:creation_date>
  <rdfs:label xml:lang="en">subperiosteal implant framework</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000285">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental implant body that is less that 3mm in diameter.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:24:40Z</oboI:creation_date>
  <rdfs:label xml:lang="en">mini dental implant body</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000286">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000242"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endodontic restorative procedure during which material is placed over exposed or nearly dental pulp in order to protect and promote healing of the dental pulp.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Pulp_capping</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:23:54Z</oboI:creation_date>
  <rdfs:label xml:lang="en">pulp capping procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000287">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000407"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bruxism that occurs during wakeful-ness and is characterised by repetitive or sustained tooth contact and/or by bracing or thrusting of the mandible.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-06-06T21:38:37Z</term:created>
  <rdfs:label xml:lang="en">awake bruxism</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000289">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surgical endodontic procedure during which medications are placed inside the pulp chamber in order to induce the formation of living replacement tissue.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.neendosol.com/procedures/pulpal-regeneration/</obo:IAO_0000119>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:34:17Z</oboI:creation_date>
  <rdfs:label xml:lang="en">pulpal regeneration procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000291">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000250"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A removable partial denture procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient's maxillary teeth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:15:55Z</oboI:creation_date>
  <rdfs:label xml:lang="en">removable maxillary partial denture procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000292">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000250"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A removable partial denture procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient's mandibular teeth.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:15:07Z</oboI:creation_date>
  <rdfs:label xml:lang="en">removable mandibular partial denture procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000293">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental implant body that is placed in the mouth for short duration of time in order to allow adequate time for healing or completion of definitive treatment planning.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:24:01Z</oboI:creation_date>
  <rdfs:label xml:lang="en">interim dental implant body</rdfs:label>
</owl:Class>

