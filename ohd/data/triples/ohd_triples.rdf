            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FMA_75152"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
              <owl:allValuesFrom>
                <owl:Class>
                  <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/FMA_55699"/>
                </owl:Class>
              </owl:allValuesFrom>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
