        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000010"/>
  <rdfs:label xml:lang="en">fractured tooth finding</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000031">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
  <obo:IAO_0000115 xml:lang="en">A disease realized as a disease course in which a carious lesion develops in a tooth, resulting in demineralization, loss of tooth structure/appearance of a cavity or other structural damage to the tooth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> Titus Schleyer 3/4/2014: definition updated</obo:IAO_0000116>
  <obo:IAO_0000116 xml:lang="en">Alan Ruttenberg 4/12/2012: We need to hook up the disease with the material basis, and possible a representation of the disease course. However we don't have the 'has material basis' relation yet, and its not clear that it is useful to represent the disease course.</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 6/26/2015:
The old uri was DOID_216. I assume this class is intended to be an import from the disease ontology.
The uri was changed for backward compatabilty in the r21 study.</obo:IAO_0000116>
  <obo:IAO_0000117 xml:lang="en">Person:Alan Ruttenberg</obo:IAO_0000117>
  <obo:IAO_0000117 xml:lang="en">Person:Bill Duncan</obo:IAO_0000117>
  <rdfs:label xml:lang="en">dental caries</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000032">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000019"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a dental exam which focuses on soft tissue in and near the mouth.</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alan Ruttenberg</obo:IAO_0000117>
  <rdfs:label xml:lang="en">soft tissue exam</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000034">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000048"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metal dental restoration material which the principal ingredient is gold.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/11/2014:
updated defintion</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 3/13/2014: slightly updated definition</obo:IAO_0000116>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gold foil dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000035">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000135"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ceramic dental restoration material that contains a glassy alumino-silicate matrix in which are embedded several crystalline phases of feldspar, mullite, or quartz.</obo:IAO_0000115>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ceramic material used for tooth-colored restorations.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">porcelain dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000135">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material that consists of non-metal, non-resin inorganic refractory compounds processed at high temperatures and pressed, polished or milled.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ceramic dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000036">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material that is primarily composed of highly cross-linked organic polymeric matrix reinforced by filler particles and/or short fibers bound to the matrix by coupling agents and set by light and or chemically activated polymerization reaction.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 3/13/2014: updated definition

Bill D. 08-04-2023: Not all resins are tooth colored. Some are cream colored. Also, updated definition source Craig's restorative Dental Material.</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Craig's restorative Dental Material</obo:IAO_0000119>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0323478212</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000037">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000652"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_12516"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material combination in which a moldable restorative material is placed directly into or on the tooth. The material then hardens and becomes (essentially) part of the tooth. </obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan 12/11/2014:
Moved from this class from being a subtype of tooth restoration procedure to being a subclass of material combination.</obo:IAO_0000116>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 1/1/2014: made definition clearer</obo:IAO_0000116>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <rdfs:label xml:lang="en">direct dental material insertion process</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000146">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000048"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metal dental restoration material that is composed of a metallic alloy that contains 25% or more of gold, palladium, and/or or platinum.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">noble metal dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000305">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000033"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000307"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A crown restoration procedure in which 3 of the 4 surfaces on an anterior tooth is restored. The dental restoration material extends to (or almost to) the gum line.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3/4 crown restoration procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000303">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000004"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000037"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000004"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth restoration procedure in which the dental restoration material is placed in the tooth via some direct dental restoration material combination process.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct restoration procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000044">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000002"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental procedure that consists of series of steps followed in a regular, orderly, definite way, performed by a dentist or dental surgeon by manual operation on some part of the mouth.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 1/14/14:checked definition, adapted it slightly</obo:IAO_0000116>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mosby's Dental Dictionary 2nd ed</obo:IAO_0000119>
  <rdfs:label xml:lang="en">surgical dental procedure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000047">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000007"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000027"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
