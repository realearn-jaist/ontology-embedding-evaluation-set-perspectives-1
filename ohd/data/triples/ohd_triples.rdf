    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A patient role that is realized by the process of being under the care of a dental health care provider.</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alan Ruttenberg</obo:IAO_0000117>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <rdfs:label xml:lang="en">dental patient role</rdfs:label>
