  <term:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mouth breathing</obo:IAO_0000112>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teeth grinding and clenching</obo:IAO_0000112>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tongue thrusting</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pathological process that involves the mouth and can contribute to some disorder of the head and neck region.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An oral parafunction can include tongue thrusting, mouth breathing, bruxism etc.</obo:IAO_0000116>
  <rdfs:label xml:lang="en">oral parafunction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001000">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000135"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ceramic dental restoration material that contains crystalline oxide of zirconium.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-07T14:36:57Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10351515/</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zirconium dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001005">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material that contains methacrylate monomers, fillers and activator initiator system to facilitate light activated and/or chemically activated polymerization reactions.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-07T15:16:39Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 4049:2009</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.iso.org/standard/42898.html</oboI:hasDbXref>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is intended for use in the cementation or fixation of restorations and appliances.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resin-based cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001006">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acid-base cement dental restoration material containing basic ion-leachable glass (fluoroaluminosilicate glass) as a powder component with polymeric water-soluble acid (polyacrylic acid, polyprotic carboxylic acid) as liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <obo:IAO_0000118 xml:lang="en">Glass Ionomer Cement (GIC)</obo:IAO_0000118>
  <obo:IAO_0000118 xml:lang="en">glass polyalkenoate cement</obo:IAO_0000118>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doi:10.3390/jfb7030016</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-19T15:23:33Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass ionomer cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001021">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material containing acid and liquid components in powder liquid form.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0323478212</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-07T15:21:32Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO standards 9917-1:2007</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.iso.org/standard/45818.html</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acid-base cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001007">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001022"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zinc-oxide cement dental restoration material containing eugenol as a liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-21T13:58:36Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zinc oxide eugenol cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001022">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acid-base cement dental restoration material containing zinc-oxide as a powder component with some specific liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0323478212</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-05T15:44:55Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO standards 3107:2022</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.iso.org/standard/84407.html</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zinc oxide cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001008">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material containing calcium aluminate, polyacrylic acid  with basic ion-leachable glass particles as  powder component with water as liquid component  to complete the acid-base reaction of glass ionomer and hydration of calcium aluminate cement.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-02-08T11:22:23Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calcium aluminate glass ionomer hybrid cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001010">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001022"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zinc-oxide cement dental restoration material containing aliphatic acid or butyric acid to substitute the eugenol as a liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:05:19Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.3390/dj10110208</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9689175/</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zinc oxide non-eugenol cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001011">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material that enables the restoration to be built up in thick layers of up to 4 mm and are recommended by manufacturers to simplify clinical technique and save time compared to traditional incremental placement.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:07:09Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bulk-filled resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001012">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material that has low-viscosity and is recommended for cervical lesions, restorations in deciduous teeth, and other small, low- or non-stress bearing restorations.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:07:24Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flowable resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001014">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material that contains macrosize filler particles.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:08:04Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">macrofilled resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001015">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material which composed of dimethacrylate resins with 0.04-μm colloidal silica fillers and prepolymerized resins, which are sometimes filled with colloidal silica.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:08:13Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microfilled resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001017">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material that contains nanometer-sized filler particles (1 to 100 nm) throughout the resin matrix.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:08:41Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nano filled resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001018">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material which consist of large particles 
(0.4 to 5 μm) with added nanometer-sized filler particles. Thus they are hybrid materials, not true nanofilled composites.</obo:IAO_0000115>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:08:57Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nano hybrid resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001019">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000036"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resin-based composite dental restoration material  that contains fluoride-releasing silicate glass filler phase and a methacrylate based matrix with carboxylic acid functional groups.</obo:IAO_0000115>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polyacid-modified glass ionomer cement</obo:IAO_0000118>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN: 978-1-4377-2418-9</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T12:09:12Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN: 978-81-312-3488-4</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compomer resin-based composite dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001020">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acid-base cement dental restoration material where in  glass ionomer cements  the glasses are fused with metals such as gold, silver, titanium, and silver to improve their strength.</obo:IAO_0000115>
  <obo:IAO_0000118 xml:lang="en">cermet dental restoration material</obo:IAO_0000118>
  <obo:IAO_0000119 xml:lang="en">Craig's restorative Dental Material</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-31T15:40:29Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metal modified glass ionomer dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001026">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acid-base cement dental restoration material with modification of  glass ionomer cement with some monomer component and associated activator initiator system to facilitate light and chemically activated polymerization reaction.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doi: 10.3390/jfb7030016</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-08T12:27:23Z</term:created>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The monomer is typically 2-hydroxyethyl methacrylate, HEMA, and the initiator is camphorquinone. Resin-modified glass-ionomers set by the twin processes of neutralization (acid-base reaction) and addition polymerization, and the resulting material has a complicated structure based on the combined products of these two reactions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resin-modified glass ionomer dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001042">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acid-base cement dental restoration material containing zinc-oxide and magnesium oxide as a powder component with phosphoric acid as liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0323478212</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-09-14T16:34:50Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zinc phosphate cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001043">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0001021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A acid-base cement dental restoration material containing zinc-oxide and magnesium oxide as a powder component with polyacrylic acid and water as liquid component to complete the acid-base reaction.</obo:IAO_0000115>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0323478212</obo:IAO_0000119>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-09-14T16:35:15Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zinc polycarboxylate cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001044">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000191"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material role that is borne by a portion of dental restoration material in association with bulk restoration and is realized in a tooth restoration procedure in which the restoration material becomes part of a restored tooth.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T11:44:24Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dental prosthesis support role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001045">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000000"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dental restoration material containing calcium hydroxide as a chief ingredient, suspended in a solvent carrier with a thickening agent.</obo:IAO_0000115>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T12:11:12Z</term:created>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calcium hydroxide cement dental restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001093">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000135"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ceramic dental restoration material that is composed of lithium disilicate embedded in a glass matrix.</obo:IAO_0000115>
  <obo:IAO_0000118 xml:lang="en">LS2</obo:IAO_0000118>
  <term:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-01-19T04:38:08Z</term:created>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1186%2Fs12903-019-0838-x</oboI:hasDbXref>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lithium disilicate restoration material</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000007">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000052"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CARO_0000012"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
  <obo:IAO_0000115 xml:lang="en">A human social role borne by a human being being realized in behaviour which is considered socially appropriate for individuals of a specific sex in the context of a specific culture.</obo:IAO_0000115>
  <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
  <obo:IAO_0000119 xml:lang="en">http://en.wikipedia.org/wiki/Gender_role</obo:IAO_0000119>
  <rdfs:label xml:lang="en">gender role</rdfs:label>
</owl:Class>

