  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a dental health care provider that bears a dental hygienist role</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bill Duncan</obo:IAO_0000117>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dental hygienist</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000021">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000260"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000258"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tooth disorder that affects a tooth that includes both the infectious organisms, the material they generate from the tooth, any immune effectors that are a response to the presence of the disorder and the physical changes to the tooth (i.e., demineralization or a cavity) resulting from the disorder. It is the physical basis for the disease "dental caries."</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer 1/14/2014: updated definition</obo:IAO_0000116>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titus Schleyer</obo:IAO_0000117>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is caries a material entity or a quality?
</rdfs:comment>
  <rdfs:label xml:lang="en">carious tooth lesion</rdfs:label>
</owl:Class>

